# Supabase project crm-fsi. The publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://yoyszukutqwoxxdolzcg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_. See docs/whatsapp.md.

# Supabase secret key (sb_secret_...). Used only by the WhatsApp webhook and the
# AI agent, which write on behalf of Meta's servers rather than a signed-in user.
# SUPABASE_SECRET_KEY=

# WhatsApp Cloud API (Meta, direct).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Optional. Graph API version (default v23.0).
# WHATSAPP_GRAPH_VERSION=
# Optional. An approved template with no variables that staff can send once the
# 24-hour reply window has closed, and its language code (default id).
# WHATSAPP_REENGAGE_TEMPLATE=
# WHATSAPP_REENGAGE_TEMPLATE_LANG=

# OpenAI. Both are required for AI replies; the model name is not hardcoded.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Later phases.
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
